    "v1Category": {
      "type": "string",
      "enum": [
        "CATEGORY_UNSPECIFIED",
        "CATEGORY_ENGINE",
        "CATEGORY_FUEL",
        "CATEGORY_PORTHOLE",
        "CATEGORY_WING"
      ],
      "default": "CATEGORY_UNSPECIFIED",
      "description": "Category — перечисление доступных категорий деталей космического корабля.\n\n - CATEGORY_UNSPECIFIED: Неизвестная категория или категория не указана\n - CATEGORY_ENGINE: Двигатели и элементы двигательной установки\n - CATEGORY_FUEL: Топливные баки и системы подачи топлива\n - CATEGORY_PORTHOLE: Иллюминаторы и смотровые окна\n - CATEGORY_WING: Крылья и аэродинамические элементы обшивки"
    },
