    "orderv1PayOrderResponse": {
      "type": "object",
      "properties": {
        "transaction_uuid": {
          "type": "string",
          "description": "transaction_uuid - идентификатор созданной платежной транзакции."
        }
      },
      "description": "PayOrderResponse возвращает информацию о транзакции."
    },
    "orderv1PaymentMethod": {
      "type": "string",
      "enum": [
        "PAYMENT_METHOD_UNKNOWN",
        "PAYMENT_METHOD_CARD",
        "PAYMENT_METHOD_SBP",
        "PAYMENT_METHOD_CREDIT_CARD",
        "PAYMENT_METHOD_INVESTOR_MONEY"
      ],
      "default": "PAYMENT_METHOD_UNKNOWN",
      "description": "PaymentMethod описывает доступные способы оплаты в системе.\n\n - PAYMENT_METHOD_UNKNOWN: UNKNOWN - способ оплаты не указан или неизвестен (значение по умолчанию).\n - PAYMENT_METHOD_CARD: CARD - оплата банковской картой.\n - PAYMENT_METHOD_SBP: SBP - оплата через Систему быстрых платежей.\n - PAYMENT_METHOD_CREDIT_CARD: CREDIT_CARD - оплата кредитной картой.\n - PAYMENT_METHOD_INVESTOR_MONEY: INVESTOR_MONEY - оплата средствами инвестора."
    },
    "paymentv1PayOrderResponse": {
      "type": "object",
      "properties": {
        "transaction_uuid": {
          "type": "string",
          "description": "transaction_uuid уникальный идентификатор созданной транзакции."
        }
      },
      "description": "PayOrderResponse содержит результат успешного проведения оплаты."
    },
    "paymentv1PaymentMethod": {
      "type": "string",
      "enum": [
        "PAYMENT_METHOD_UNSPECIFIED",
        "PAYMENT_METHOD_CARD",
        "PAYMENT_METHOD_SBP",
        "PAYMENT_METHOD_CREDIT_CARD",
        "PAYMENT_METHOD_INVESTOR_MONEY"
      ],
      "default": "PAYMENT_METHOD_UNSPECIFIED",
      "description": "PaymentMethod описывает доступные способы оплаты заказа.\n\n - PAYMENT_METHOD_UNSPECIFIED: PAYMENT_METHOD_UNSPECIFIED способ оплаты не указан (значение по умолчанию).\n - PAYMENT_METHOD_CARD: PAYMENT_METHOD_CARD оплата стандартной банковской картой.\n - PAYMENT_METHOD_SBP: PAYMENT_METHOD_SBP оплата через Систему быстрых платежей.\n - PAYMENT_METHOD_CREDIT_CARD: PAYMENT_METHOD_CREDIT_CARD оплата кредитной картой.\n - PAYMENT_METHOD_INVESTOR_MONEY: PAYMENT_METHOD_INVESTOR_MONEY оплата с использованием средств инвестора."
    },
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
